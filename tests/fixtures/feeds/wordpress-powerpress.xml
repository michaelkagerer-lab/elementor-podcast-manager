		<wfw:commentRss>https://beyondpodcasting.com/podcatcher-appsmy-first-indie-song-production-in-3-locationsdistribution/feed/</wfw:commentRss>
		<slash:comments>0</slash:comments>
		<category><![CDATA[Podcatcher apps]]></category>
		<category><![CDATA[RØDECaster Pro]]></category>
		<category><![CDATA[RSS]]></category>
		<category><![CDATA[Song production]]></category>
		<category><![CDATA[castellano]]></category>
		<category><![CDATA[Castilian]]></category>
