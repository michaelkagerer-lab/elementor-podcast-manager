#. Plugin Name of the plugin
#: elementor-podcast-manager.php
msgid "Elementor Podcast Manager"
msgstr "Elementor Podcast Manager"

#. Description of the plugin
#: elementor-podcast-manager.php
msgid ""
"Manage and display a podcast on Elementor websites. Episodes, RSS feed, "
"custom player, and Elementor widgets — no external podcast platform "
"required."
msgstr ""
"Verwalte und zeige einen Podcast auf Elementor-Websites. Folgen, RSS-Feed, "
"eigener Player und Elementor-Widgets – ohne externe Podcast-Plattform."

