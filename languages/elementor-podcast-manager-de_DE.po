#: admin/views/design.php:77
msgid ""
"Players and the area around podcast components. Usually your site’s "
"background color."
msgstr ""
"Player und Bereich um die Podcast-Komponenten. Meist die Hintergrundfarbe "
"deiner Website."

#: admin/views/design.php:78
msgid "Surface"
msgstr "Fläche"

#: admin/views/design.php:78
msgid "Episode cards, the sticky player and error messages."
msgstr "Folgenkarten, fixierter Player und Fehlermeldungen."

